# ============================================================
# Study Hub — environment variable template
#
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored — never commit real keys.
# ============================================================

# Supabase project URL (from Supabase dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (meant to be public; RLS is the real boundary)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DeepSeek API key (server-side only — never use NEXT_PUBLIC_ for this)
DEEPSEEK_API_KEY=

# DeepSeek model (optional). Defaults to "deepseek-chat" (the cheap model).
# Set to your desired model name only if you intentionally want a different one.
DEEPSEEK_MODEL=deepseek-chat