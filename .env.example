# ============================================================
# Study Hub — environment variable template
#
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored — never commit real keys.
# ============================================================

# Supabase project URL (from Supabase dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (meant to be public; RLS is the real boundary)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub OAuth (auth provider) requires NO extra environment variables.
# Configure it in TWO dashboards (the "redirect_uri is not associated"
# GitHub error is almost always caused by mixing these up):
#
#   1) GITHUB side -> your OAuth App -> "Authorization callback URL" must be
#      Supabase's INTERNAL callback, NOT your app URL:
#        https://<project-ref>.supabase.co/auth/v1/callback
#      (Copy the exact URL from the GitHub provider panel in Supabase:
#       Authentication -> Providers -> GitHub — it says "Callback URL".)
#      Example: https://abcdefghijk.supabase.co/auth/v1/callback
#
#   2) SUPABASE side -> Authentication -> URL Configuration -> Redirect URLs:
#      add your app's callback so Supabase can forward the user back to you:
#        http://localhost:3000/auth/callback
#        http://localhost:3000/**          (wildcard so `?next=` works on
#                                            every local route)
#      and Authentication -> Providers -> GitHub: paste the Client ID +
#      Client secret from GitHub.
#
# The browser + server auth clients in src/lib/supabase/ only read the
# two NEXT_PUBLIC_ variables above.

# DeepSeek API key (server-side only — never use NEXT_PUBLIC_ for this)
DEEPSEEK_API_KEY=

# DeepSeek model (optional). Defaults to "deepseek-chat" (the cheap model).
# Set to your desired model name only if you intentionally want a different one.
DEEPSEEK_MODEL=deepseek-chat